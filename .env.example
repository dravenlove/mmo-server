# 复制为 .env 后填写随机密钥；四个服务必须使用完全相同的值，至少 32 字符。
INTERNAL_TOKEN=
MMO_IMAGE_TAG=dev
# 构建网络：Debian 源只填域名。慢时先按 docs/BUILD_TROUBLESHOOTING.md 测速。
DEBIAN_MIRROR=deb.debian.org
GOPROXY=https://proxy.golang.org,direct
# 玩家入口默认只允许本机连接；其他宿主端口固定绑定回环地址。
# 公开部署请使用 deploy/ 中的模板及 TLS。
LOCAL_BIND_IP=127.0.0.1
TICK_HZ=20
AOI_RADIUS=30
MOVE_SPEED=6
# 留空表示本机明文演示。启用 TLS 时填写容器内的 /certs/ 路径。
TLS_CERT_DIR=./deploy/certs
TLS_CERT_FILE=
TLS_KEY_FILE=
