<Application x:Class="Mmo.Client.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="PanelBrush" Color="#121D30"/>
  <SolidColorBrush x:Key="LineBrush" Color="#283852"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DDE6F5"/><Setter Property="FontFamily" Value="Microsoft YaHei UI"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#0B1424"/><Setter Property="Foreground" Value="#EAF1FF"/>
   <Setter Property="BorderBrush" Value="#354764"/><Setter Property="Padding" Value="10,8"/>
   <Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="CaretBrush" Value="White"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EAF1FF"/><Setter Property="Background" Value="#253751"/>
   <Setter Property="BorderBrush" Value="#3A506F"/><Setter Property="Padding" Value="14,8"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.82"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.6"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.38"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DDE6F5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="13"/></Style>
 </Application.Resources>
</Application>
