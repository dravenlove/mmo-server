<Window x:Class="Mmo.Client.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Mmo.Client.Desktop"
 Title="MMO 联调客户端" Width="1260" Height="850" MinWidth="1080" MinHeight="740"
 Background="#0B1220" FontFamily="Microsoft YaHei UI" FontSize="13"
 WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" PreviewKeyUp="Window_KeyUp" Deactivated="Window_Deactivated" Closing="Window_Closing">
 <Grid Margin="22,16,22,18">
  <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="110"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0">
   <StackPanel DockPanel.Dock="Left">
    <TextBlock Text="MMO 联调客户端" FontSize="25" FontWeight="SemiBold"/>
    <TextBlock Text="本机连接远程网关 · 实时场景与业务验收" Foreground="#8EA3C2" Margin="0,5,0,0"/>
   </StackPanel>
   <Border x:Name="StatusPlate" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1D2B42" CornerRadius="16" Padding="15,8">
    <TextBlock x:Name="StatusLabel" Text="●  尚未连接" Foreground="#9BAEC9"/>
   </Border>
  </DockPanel>
  <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Grid.Column="0" Text="网关地址（IP 或域名:端口）" Foreground="#8EA3C2" Margin="0,0,0,7"/>
    <TextBlock Grid.Column="1" Text="本机角色档案" Foreground="#8EA3C2" Margin="12,0,0,7"/>
    <TextBlock Grid.Column="2" Text="连接方式" Foreground="#8EA3C2" Margin="12,0,0,7"/>
    <TextBox x:Name="AddressBox" Grid.Row="1" Text="127.0.0.1:7000" AutomationProperties.AutomationId="GatewayAddress"/>
    <TextBox x:Name="ProfileBox" Grid.Row="1" Grid.Column="1" Text="desktop-check" Margin="12,0,0,0" AutomationProperties.AutomationId="ProfileName"/>
    <CheckBox x:Name="TlsBox" Grid.Row="1" Grid.Column="2" Content="TLS 加密（校验证书）" Margin="12,0,0,0" Checked="Tls_Changed" Unchecked="Tls_Changed"/>
    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="14,0,0,0">
     <Button x:Name="ProbeButton" Content="测试连接" Click="Probe_Click" Margin="0,0,8,0" AutomationProperties.AutomationId="ProbeConnection"/>
     <Button x:Name="ConnectButton" Content="连接并登录" Click="Connect_Click" Background="#326BE5" BorderBrush="#4D87FC" AutomationProperties.AutomationId="ConnectAndLogin"/>
     <Button x:Name="DisconnectButton" Content="断开" Click="Disconnect_Click" Margin="8,0,0,0" IsEnabled="False"/>
    </StackPanel>
    <TextBlock x:Name="ConnectionHint" Grid.Row="2" Grid.ColumnSpan="4" Margin="0,10,0,0" Foreground="#8498B8" TextWrapping="Wrap" Text="先测试网关是否可达，再连接角色。明文 TCP 适合联调；公网使用 TLS 可保护登录凭据。"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2" Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,14,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新视图" Padding="10,4" Margin="12,0,0,0" IsEnabled="False" Click="Refresh_Click"/><TextBlock Text="实时场景" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="TickLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Text="等待服务器状态" Foreground="#8EA3C2"/></DockPanel>
     <local:WorldCanvas x:Name="World" Grid.Row="1" Focusable="True" MouseDown="World_MouseDown"/>
     <DockPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="● 自己" Foreground="#4ADEAC"/><TextBlock Text="    ● 邻近玩家" Foreground="#64A8FF"/><TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="点击场景后按 WASD / 方向键移动" Foreground="#8EA3C2"/></DockPanel>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="角色状态" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,7"/>
      <TextBlock x:Name="RoleNameLabel" Text="尚未登录" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock x:Name="SceneLabel" Text="场景  —" Foreground="#8EA3C2" Margin="0,3,0,0"/>
      <TextBlock x:Name="PositionLabel" Text="坐标  —" Foreground="#8EA3C2" Margin="0,3,0,0"/>
      <Grid Margin="0,8,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="金币" Foreground="#8EA3C2"/><TextBlock x:Name="CoinsLabel" Text="—" FontSize="24" Foreground="#F6CF76"/></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock Text="往返延迟" Foreground="#8EA3C2"/><TextBlock x:Name="LatencyLabel" Text="—" FontSize="24"/></StackPanel>
      </Grid>
      <Button x:Name="ClaimButton" Content="领取 100 金币" IsEnabled="False" Click="Claim_Click"/>
      <TextBlock Text="移动控制 · 按住方向按钮" Foreground="#8EA3C2" Margin="0,6,0,5"/>
      <Grid HorizontalAlignment="Center">
       <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="36"/></Grid.RowDefinitions>
       <Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="65"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
       <Button x:Name="UpButton" Grid.Column="1" Content="↑" Tag="0,1" Margin="3" IsEnabled="False" PreviewMouseLeftButtonDown="Move_Down" PreviewMouseLeftButtonUp="Move_Up" LostMouseCapture="Move_LostCapture"/>
       <Button x:Name="LeftButton" Grid.Row="1" Content="←" Tag="-1,0" Margin="3" IsEnabled="False" PreviewMouseLeftButtonDown="Move_Down" PreviewMouseLeftButtonUp="Move_Up" LostMouseCapture="Move_LostCapture"/>
       <Button x:Name="DownButton" Grid.Row="1" Grid.Column="1" Content="↓" Tag="0,-1" Margin="3" IsEnabled="False" PreviewMouseLeftButtonDown="Move_Down" PreviewMouseLeftButtonUp="Move_Up" LostMouseCapture="Move_LostCapture"/>
       <Button x:Name="RightButton" Grid.Row="1" Grid.Column="2" Content="→" Tag="1,0" Margin="3" IsEnabled="False" PreviewMouseLeftButtonDown="Move_Down" PreviewMouseLeftButtonUp="Move_Up" LostMouseCapture="Move_LostCapture"/>
      </Grid>
      <TextBlock Text="场景切换" Foreground="#8EA3C2" Margin="0,10,0,5"/>
      <ComboBox x:Name="TargetSceneBox" SelectedIndex="1"><ComboBoxItem Tag="scene-1"><TextBlock Text="scene-1" Foreground="#16213B"/></ComboBoxItem><ComboBoxItem Tag="scene-2"><TextBlock Text="scene-2" Foreground="#16213B"/></ComboBoxItem></ComboBox>
      <Button x:Name="TransferButton" Content="切换场景" Margin="0,8,0,0" IsEnabled="False" Click="Transfer_Click"/>
      <TextBlock x:Name="TransferHint" Text="切换过程中会暂时停止移动。" Foreground="#8EA3C2" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="连接与操作记录" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Padding="0" Background="Transparent" Foreground="#9EB3D0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
   </Grid>
  </Border>
 </Grid>
</Window>
