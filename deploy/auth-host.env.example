# 鉴权 / 后台主机：仅账号注册与登录验证，不承载在线游戏链路。
# 与 game-host.env 保持相同的既有密钥，不能在更新时重新生成。
INTERNAL_TOKEN=
MMO_IMAGE_PREFIX=ghcr.io/dravenlove/mmo-server
MMO_IMAGE_TAG=game-auth-20261111-v1
# 默认走 game -> auth 的 SSH 连接建立的反向 MySQL 转发。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=mmo_app
MYSQL_PASSWORD=''
MYSQL_DATABASE=mmo
MYSQL_TLS=false
