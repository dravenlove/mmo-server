# 主机 A：Go Gateway + Backend + SQLite。
# 两台主机填写完全相同的随机密钥，例如 openssl rand -hex 32 的输出。
INTERNAL_TOKEN=
MMO_IMAGE_TAG=dev
# 本地镜像使用 mmo；网上镜像使用 ghcr.io/dravenlove/mmo-server。
MMO_IMAGE_PREFIX=mmo
# mysql 模式填写可达地址、账号和已创建的独立数据库；详见 docs/MYSQL.md。
BACKEND_DB_DRIVER=sqlite
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=''
MYSQL_DATABASE=
MYSQL_TLS=false
# 镜像构建使用；Debian 源只填域名。详见 docs/BUILD_TROUBLESHOOTING.md。
DEBIAN_MIRROR=deb.debian.org
GOPROXY=https://proxy.golang.org,direct
# 主机 B 可被 A 的容器访问的真实 IPv4 私网/VPN地址，不要填容器名。
SCENE_HOST_IP=10.20.0.22
# 主机 A 真实网卡地址。公网入口启用下面的 TLS；本机测试可改127.0.0.1。
GATEWAY_BIND_IP=10.20.0.11
# 新部署默认卷。已有数据时必须选择迁移后的卷或原卷，禁止两个Backend同时打开。
BACKEND_VOLUME_NAME=mmo-two-host-backend-data
TLS_CERT_DIR=./certs
TLS_CERT_FILE=
TLS_KEY_FILE=
