# scene 主机：两个 C++ 场景容器共用一个场景镜像。
INTERNAL_TOKEN=
# VPS 默认直接拉取已发布镜像；本地构建或离线包须改为 mmo 和对应标签。
MMO_IMAGE_TAG=combat-20261106-v1
MMO_IMAGE_PREFIX=ghcr.io/dravenlove/mmo-server
# 镜像构建使用；Debian 源只填域名。详见 docs/BUILD_TROUBLESHOOTING.md。
DEBIAN_MIRROR=deb.debian.org
# `scene` 主机 实际网卡上的 IPv4 私网/VPN地址，与`gateway` 主机 的SCENE_HOST_IP一致。
SCENE_BIND_IP=10.20.0.22
TICK_HZ=20
AOI_RADIUS=30
MOVE_SPEED=6
