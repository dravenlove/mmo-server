# 游戏主机：Gateway + 游戏 Backend + 两个 C++ Scene，同机 Docker 网络。
INTERNAL_TOKEN=
MMO_IMAGE_PREFIX=ghcr.io/dravenlove/mmo-server
MMO_IMAGE_TAG=game-auth-20261111-v1
# 真实网卡地址；云公网 EIP 通常映射到这个私网地址。
GATEWAY_BIND_IP=10.20.0.11
# SSH 在游戏主机私网 IP 上转发至鉴权主机的 127.0.0.1:8082。
AUTH_URL=http://10.20.0.11:8082
BACKEND_DB_DRIVER=mysql
MYSQL_HOST=10.20.0.33
MYSQL_PORT=3306
MYSQL_USER=mmo_app
MYSQL_PASSWORD=''
MYSQL_DATABASE=mmo
MYSQL_TLS=false
# 老部署沿用原卷名；MySQL 模式仍保留卷用于兼容，不清理它。
BACKEND_VOLUME_NAME=mmo-two-host-backend-data
TLS_CERT_DIR=./certs
TLS_CERT_FILE=
TLS_KEY_FILE=
TICK_HZ=20
AOI_RADIUS=30
MOVE_SPEED=6
# 迁移时复制原规则目录；留空 COMBAT_CONFIG_FILE 使用内置默认规则。
COMBAT_CONFIG_DIR=./combat-config
COMBAT_CONFIG_FILE=
