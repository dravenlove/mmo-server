# 游戏主机：Gateway + 游戏 Backend + 两个 C++ Scene，同机 Docker 网络。
INTERNAL_TOKEN=
MMO_IMAGE_PREFIX=ghcr.io/dravenlove/mmo-server
MMO_IMAGE_TAG=elemental-20261112-v1
# 可独立更新五个 Gateway 和游戏 Backend；留空时沿用 MMO_IMAGE_TAG。
MMO_GATEWAY_IMAGE_TAG=account-20261113-v1
MMO_BACKEND_IMAGE_TAG=account-20261113-v1
MMO_SKILL_LAB_IMAGE_TAG=skill-lab-20261112-v1
# 真实网卡地址；云公网 EIP 通常映射到这个私网地址。
GATEWAY_BIND_IP=10.20.0.11
# SSH 绑定游戏主机 docker0 网桥地址，避免暴露公网；以 ip addr show docker0 为准。
AUTH_URL=http://172.17.0.1:8082
BACKEND_DB_DRIVER=mysql
MYSQL_HOST=10.20.0.33
MYSQL_PORT=3306
MYSQL_USER=mmo_app
MYSQL_PASSWORD=''
MYSQL_DATABASE=mmo
MYSQL_TLS=false
# 老部署沿用原卷名；MySQL 模式仍保留卷用于兼容，不清理它。
BACKEND_VOLUME_NAME=mmo-two-host-backend-data
TLS_CERT_DIR=./certs
TLS_CERT_FILE=
TLS_KEY_FILE=
TICK_HZ=20
AOI_RADIUS=30
MOVE_SPEED=6
# 迁移时复制原规则目录；留空 COMBAT_CONFIG_FILE 使用内置默认规则。
COMBAT_CONFIG_DIR=./combat-config
COMBAT_CONFIG_FILE=

# Unity WebGL 专用移动场景；旧战斗场景不受这些参数影响。
WEBGL_TICK_HZ=20
WEBGL_STATE_HZ=20
WEBGL_AOI_RADIUS=30
WEBGL_MOVE_SPEED=6
WEBGL_TRACE_MOVEMENT=true

# 独立战斗联调场景；不修改移动场景的规则。
COMBAT_PVP_ENABLED=true
COMBAT_STATE_HZ=20
SKILL_LAB_STATE_HZ=20
