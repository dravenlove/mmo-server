# gateway 主机：Go Gateway + Backend，数据库可选 SQLite / MySQL。
# 两台主机填写完全相同的随机密钥，例如 openssl rand -hex 32 的输出。
INTERNAL_TOKEN=
# VPS 默认直接拉取已发布镜像；本地构建或离线包须改为 mmo 和对应标签。
MMO_IMAGE_TAG=mvp-20261105-mysql
MMO_IMAGE_PREFIX=ghcr.io/dravenlove/mmo-server
# mysql 模式填写可达地址、账号和已创建的独立数据库；详见 docs/MYSQL.md。
BACKEND_DB_DRIVER=sqlite
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=''
MYSQL_DATABASE=
MYSQL_TLS=false
# 镜像构建使用；Debian 源只填域名。详见 docs/BUILD_TROUBLESHOOTING.md。
DEBIAN_MIRROR=deb.debian.org
GOPROXY=https://proxy.golang.org,direct
# `scene` 主机 可被 `gateway` 的容器访问的真实 IPv4 私网/VPN地址，不要填容器名。
SCENE_HOST_IP=10.20.0.22
# `gateway` 主机 真实网卡地址。公网入口启用下面的 TLS；本机测试可改127.0.0.1。
GATEWAY_BIND_IP=10.20.0.11
# 新部署默认卷。已有数据时必须选择迁移后的卷或原卷，禁止两个Backend同时打开。
BACKEND_VOLUME_NAME=mmo-two-host-backend-data
TLS_CERT_DIR=./certs
TLS_CERT_FILE=
TLS_KEY_FILE=
