INTERNAL_TOKEN=
MMO_IMAGE_TAG=dev
BACKEND_URL=http://10.20.0.11:8081
# 示例为网关所在主机的私网地址，可配公网 IP 或 0.0.0.0，但仅开放 TCP 7000。
GATEWAY_BIND_IP=10.20.0.31
# 使用主机绝对路径；文件必须可由容器 UID/GID 10001 读取。
TLS_CERT_DIR=/opt/mmo/certs
# 公网部署必须配置有效证书；仅私网演示可以将下面两项留空。
TLS_CERT_FILE=/certs/fullchain.pem
TLS_KEY_FILE=/certs/privkey.pem
